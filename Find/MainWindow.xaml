<Window
    x:Class="Find.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Shapes on a plane"
    Width="715"
    Height="633"
    MinWidth="715"
    MinHeight="250"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="GhostWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition />
            <RowDefinition Height="26" />
            <RowDefinition Height="72.04" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="113" />
                <ColumnDefinition />
                <ColumnDefinition Width="113" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="1"
                Margin="5,10,-3,10"
                BorderBrush="#FFBFBFFD"
                FontSize="12"
                HorizontalScrollBarVisibility="Hidden"
                Text="{Binding ShapesFolderPath, Mode=TwoWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Hidden" />
            <Button
                Margin="10,10,5,10"
                Background="White"
                BorderBrush="#FFBFBFFD"
                Command="{Binding SaveCommand}"
                Content="Save"
                Focusable="False"
                FontSize="12" />
            <Button
                Grid.Column="2"
                Margin="0,10,10,10"
                Background="White"
                BorderBrush="#FFBFBFFD"
                Command="{Binding SelectFolderCommand}"
                Focusable="False"
                FontSize="12">
                <TextBlock Text="Select Folder" TextWrapping="Wrap" />
            </Button>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="410" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="10,5,0,0">
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="Average perimeter:"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="Average Area:"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="The shape of the largest area:"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="The type of shape with the largest average perimeter:"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,5,0,0">
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="{Binding AveragePerimeter}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="{Binding AverageArea}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="{Binding LargestAreaShape}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Courier New"
                    FontSize="12"
                    Text="{Binding ShapeWithMaxAveragePerimeter}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--<StackPanel Grid.Row="3" Margin="10,5,10,10">

        </StackPanel>-->
        <TextBox
            Grid.Row="1"
            Margin="10,0,10,0"
            AcceptsReturn="True"
            HorizontalScrollBarVisibility="Auto"
            Text="{Binding PlainText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <!--<RichTextBox
            x:Name="editor_richtextbox"
            Grid.Row="1"
            Margin="10,0,10,0"
            FontFamily="Courier New"
            FontSize="12"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <FlowDocument>
                <Paragraph />
            </FlowDocument>
        </RichTextBox>-->
        <Grid Grid.Row="2" Margin="10,-1,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="89" />
                <ColumnDefinition />
                <ColumnDefinition Width="89" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Width="468"
                Margin="1,0,0,0"
                Orientation="Horizontal">
                <Button
                    Grid.Column="2"
                    Width="76"
                    Margin="0,0,5,0"
                    Background="White"
                    BorderBrush="#FFBFBFFD"
                    Command="{Binding AddTrapezoidCommand}"
                    Content="Trapezoid"
                    Focusable="False">
                    <Button.ToolTip>
                        <StackPanel>
                            <Label Content="Trapezoid" FontWeight="Bold" />
                            <TextBlock FontFamily="Courier New">
                                <Run Text="  __b__" /><LineBreak /><Run Text="a/_____\c" /><LineBreak /><Run Text="    d" /><LineBreak /><Run Text="Порядок сторон трапеции" />
                            </TextBlock>
                        </StackPanel>
                    </Button.ToolTip>
                </Button>
                <Button
                    Grid.Column="3"
                    Width="93"
                    Margin="0,0,5,0"
                    Background="White"
                    BorderBrush="#FFBFBFFD"
                    Command="{Binding AddCircleCommand}"
                    Content="Circle"
                    Focusable="False"
                    ToolTip="Circle" />
                <Button
                    Grid.Column="4"
                    Width="115"
                    Margin="0,0,5,0"
                    Background="White"
                    BorderBrush="#FFBFBFFD"
                    Command="{Binding AddRectangleCommand}"
                    Content="Rectangle"
                    Focusable="False"
                    ToolTip="Rectangle" />
                <Button
                    Grid.Column="5"
                    Width="67"
                    Margin="0,0,5,0"
                    Background="White"
                    BorderBrush="#FFBFBFFD"
                    Command="{Binding AddSquareCommand}"
                    Content="Square"
                    Focusable="False"
                    ToolTip="Square" />
                <Button
                    Grid.Column="6"
                    Width="96"
                    Margin="0,0,10,0"
                    Background="White"
                    BorderBrush="#FFBFBFFD"
                    Command="{Binding AddTriangleCommand}"
                    Content="Triangle"
                    Focusable="False"
                    ToolTip="Triangle" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Background="#FFBFD0F3"
                BorderBrush="#FFBFBFFD"
                Command="{Binding CalculateCommand}"
                Content="Calculate"
                Focusable="False" />
            <Button
                Background="White"
                BorderBrush="#FFBFBFFD"
                Command="{Binding ClearCommand}"
                Content="Clear"
                Focusable="False" />
        </Grid>

        <!--<TextBox x:Name="editor_textbox" Margin="10,10,10,10" Text="123" TextWrapping="Wrap" BorderBrush="#FFBFBFFD" Grid.Row="1" FontSize="12" FontFamily="Courier New"/>-->
    </Grid>
</Window>
