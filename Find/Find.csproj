<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <Version>1.0.1</Version>
    <Company>Company name</Company>
    <Product>Find Shapes</Product>
    <Authors>Andrei Samusenka</Authors>
    <Copyright>© 2025 Andrei Samusenka</Copyright>
    <Description>1. Opening text files containing the following structure:

{ "type" : trapezoid; "side_a" : 1; "side_b" : 2; "side_c" : 1; "side_d" : 3; }
{ "type" : circle; "radius" : 10; }
{ "type" : rectangle; "width" : 1; "height" : 1; }
{ "type" : square; "side" : 2; }
{ "type" : triangle; "side_a" : 1; "side_b" : 1; "side_c" : 1; }
      
Each block in curly braces describes the parameters of a shape. Every block must contain a "type" field.

2. Saving/Opening text files.
3. A document editor inside the program window.
4. Adding shapes by clicking the corresponding buttons (Trapezoid, Circle, Rectangle, Triangle, Square).
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassLibrary\ShapeLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
  </ItemGroup>

</Project>