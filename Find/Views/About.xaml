<Window
    x:Class="Find.Views.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Find.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Find.ViewModels"
    Title="About"
    d:DataContext="{d:DesignInstance Type=viewmodels:AboutViewModel}"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <StackPanel Margin="10">
            <TextBlock Margin="0,0,0,5" Text="{Binding Company}" />
            <TextBlock Margin="0,0,0,5" Text="{Binding Product}" />
            <TextBlock Margin="0,0,0,5" Text="{Binding Version}" />
            <TextBlock Margin="0,0,0,5" Text="{Binding Description}" />
            <TextBlock Margin="0,0,0,5" Text="{Binding Copyright}" />
            <TextBlock Text="{Binding Author}" />
        </StackPanel>
        <Button
            Grid.Row="1"
            Width="80"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{x:Null}"
            Command="{Binding AcceptCommand}"
            Content="Ok" />
    </Grid>
</Window>
